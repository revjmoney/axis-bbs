# Arduino as an ESP-IDF component, with settings sized for a no-PSRAM CYD BBS (Arduino's prebuilt ones waste RAM)
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_ARDUINO_LOOP_STACK_SIZE=8192
CONFIG_ARDUINO_RUNNING_CORE=1
CONFIG_ARDUINO_EVENT_RUNNING_CORE=1
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y

# no Bluetooth, no PSRAM (the CYD has none), no core dump (no partition for it)
# CONFIG_BT_ENABLED is not set
# CONFIG_ESP32_SPIRAM_SUPPORT is not set
# CONFIG_SPIRAM is not set
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y

# WiFi: static RX stays at 4 (~1.6 KB each, always resident; at least the RX block-ack window).
# Dynamic RX and TX may grow only to 8, and dynamic RX stays at least the static count.
# A busy main can no longer spend the old 16-buffer ceiling while a door is allocating pages.
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP32_WIFI_RX_BA_WIN=4
CONFIG_ESP32_WIFI_AMPDU_TX_ENABLED=y

# lwIP: 16 sockets. Windows are 2 * MSS (2880) instead of Arduino's 4 * MSS (5760).
# Each connected TCP socket then holds about 5.6 KB less send and receive buffer.
# Telnet still has two segments in flight. A ZMODEM download is slower, not smaller.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880

# TLS (the ring board's Discord/DDNS posts): allocate on demand
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# the LittleFS component Arduino's LittleFS library needs
CONFIG_LITTLEFS_MAX_PARTITIONS=3

# what Arduino's WiFiClientSecure needs
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y

# the bootloader must fit below the partition table at 0x8000
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# the SD card exactly as Arduino reads it (long names: the scene packs need them)
CONFIG_FATFS_CODEPAGE_850=y
CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# FatFs sizes every file buffer from the larger of the SD sector (512) and this
# wear-levelling sector. Nothing here uses wear levelling (LittleFS holds the
# internal flash). The default 4096 makes the volume window and each of the 10
# SD file slots a 4096-byte buffer, about 45 KB, on the only board with a card.
# 512 matches the card. The card's own bytes are not rewritten.
CONFIG_WL_SECTOR_SIZE_512=y
# CONFIG_WL_SECTOR_SIZE_4096 is not set

# Instruction RAM for the 8086 door. WiFi and SPI interrupt code were already left in
# flash (Arduino does the same; that WiFi choice is what freed the door's IRAM arena).
# Sleep-mode WiFi code is pinned off too: with the other two off, that option would
# take about 7 KB of IRAM back. New in this file: non-ISR FreeRTOS calls move to flash
# (the option's own note: up to about 8 KB of IRAM) and non-ISR ring-buffer calls do
# the same. Their interrupt copies stay in IRAM, because a UART interrupt still runs
# from there and cannot call flash while the cache is off.
# CONFIG_ESP32_WIFI_IRAM_OPT is not set
# CONFIG_ESP32_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_SLP_IRAM_OPT is not set
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set
# CONFIG_SPI_SLAVE_ISR_IN_IRAM is not set
# CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH is not set
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
